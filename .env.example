# Copy to .env.local. Never commit .env.local.

# demo or live. Anything else is treated as a configuration error.
APP_MODE=demo

# Required before APP_MODE=live. At least 8 characters. Shared passphrase, not a user account.
DASHBOARD_ACCESS_CODE=

# Server-side Supabase. Prefer SUPABASE_URL so the browser does not need it.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Present for operators who already have it. This app does not send it to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Slack. The bot token is optional for live events and required for history backfill.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
SLACK_CHANNEL_NAME=

# Optional. Server-only. The assistant stays disabled when this is blank.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# ── Operations (orders → RevOps → inventory → logistics) ──
# Public URL of this app, used for "Open in dashboard" buttons on Slack cards.
APP_BASE_URL=
# Optional team channels. When an order reaches a team's stage, the bot posts a link there.
SLACK_REVOPS_CHANNEL_ID=
SLACK_INVENTORY_CHANNEL_ID=
SLACK_LOGISTICS_CHANNEL_ID=

# ── AI assistant ──
# Claude is used first, then OpenAI (above), then fixed reports with no model.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-4-5.
ANTHROPIC_MODEL=

# ── MCP server (/api/mcp) ──
# Long random string. Clients send "Authorization: Bearer <MCP_TOKEN>". Blank = endpoint off.
MCP_TOKEN=

# ── EPIK Support pilot (/cx) ──
# true shows the pilot and its tile on the EPIK home. Anything else hides it completely.
NEXT_PUBLIC_CX_PILOT=
# Shared ticket store: kv (default, Vercel KV / Upstash) or mock (one server's memory, local tests only).
CX_DATA_ADAPTER=kv
# Filled in by Vercel when you add KV (Upstash) to the project. UPSTASH_REDIS_REST_URL/_TOKEN also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Sign-in. A long random string (32+ characters); required on the live site.
CX_SESSION_SECRET=
# Access by level: one code per level (6+ characters). After the code, people pick their name from the roster.
CX_ACCESS_CODE_L1=
CX_ACCESS_CODE_L2=
CX_ACCESS_CODE_L3=
CX_ACCESS_CODE_ADMIN=
CX_ACCESS_CODE_VIEWER=
# The old single dashboard code keeps working as this level until the codes above are set: admin (default), l1, … or off.
CX_LEGACY_CODE_AS=admin
# codes (default) or google. Google sign-in is limited to @getepik.in (redirect /api/cx/auth/callback).
CX_AUTH_MODE=codes
CX_GOOGLE_CLIENT_ID=
CX_GOOGLE_CLIENT_SECRET=
# Google mode only: email=rosterId pairs (ids from src/features/cx/config/users.json), kept out of git.
CX_USERS=
# Google mode only: admin emails, comma separated.
CX_ADMIN_EMAILS=
# Sample week allowed on the live site (always allowed locally).
CX_ALLOW_SAMPLE=false
# Optional language-model layer on top of the rules. Off unless true; rules alone decide otherwise.
CX_LLM_ENABLED=false
CX_LLM_PROVIDER=
CX_LLM_MODEL=
CX_LLM_API_KEY=
# Read-only Sagepilot import. Off unless true. Server-side only.
CX_SAGEPILOT_ENABLED=false
SAGEPILOT_API_TOKEN=
SAGEPILOT_WORKSPACE_ID=
# https://app.sagepilot.ai (default) or https://eu.sagepilot.ai
SAGEPILOT_BASE_URL=
# calendar (default) or business hours for SLA clocks.
CX_BUSINESS_HOURS_MODE=

# Shopify (optional). The app reads orders and products, creates draft orders, and completes only the drafts it made
# (payment pending). It never edits, cancels, refunds or marks anything paid.
# Shopify admin → Settings → Apps → Develop apps → Build apps in Dev Dashboard → Create app "EPIK Ops",
# scopes read_orders, read_products, write_draft_orders, write_payment_terms → Release → Install on the store.
# Store: the handle from admin.shopify.com/store/<handle>, or <handle>.myshopify.com.
SHOPIFY_STORE_DOMAIN=
# From the app's Settings in the Dev Dashboard. The app fetches its own 24-hour token with these.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only for a legacy custom app made in the admin before 2026 (instead of the client ID and secret).
# SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2026-10
# What a CDE's Slack sale becomes in Shopify:
#   order = a real order with the #PIK number straight away, payment pending (needs the write_payment_terms permission)
#   draft = a draft the team checks and completes by hand
#   off   = nothing (default)
SHOPIFY_SLACK_SALES=off
# Bring website orders (and Sagepilot chat orders) created on or after this date into the dashboard. Blank: off.
# Older orders are never touched. Format YYYY-MM-DD.
SHOPIFY_IMPORT_FROM=
